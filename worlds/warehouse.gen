"""Procedural warehouse world for Genesis AI."""

import genesis as gs


def create_world():
    world = gs.World()

    # Ground plane
    ground = gs.morphs.Box(size=[20, 20, 0.1], pos=[0, 0, -0.05])
    ground_mat = gs.materials.Rigid(color=[0.8, 0.8, 0.8, 1.0])
    world.add_entity(morph=ground, material=ground_mat)

    # Walls
    wall_mat = gs.materials.Rigid(color=[0.6, 0.6, 0.6, 1.0])
    north_wall = gs.morphs.Box(size=[20, 0.2, 2.5], pos=[0, 10, 1.25])
    world.add_entity(morph=north_wall, material=wall_mat)
    
    south_wall = gs.morphs.Box(size=[20, 0.2, 2.5], pos=[0, -10, 1.25])
    world.add_entity(morph=south_wall, material=wall_mat)
    
    east_wall = gs.morphs.Box(size=[0.2, 20, 2.5], pos=[10, 0, 1.25])
    world.add_entity(morph=east_wall, material=wall_mat)
    
    west_wall = gs.morphs.Box(size=[0.2, 20, 2.5], pos=[-10, 0, 1.25])
    world.add_entity(morph=west_wall, material=wall_mat)

    # Tall shelves
    tall_shelf_mat = gs.materials.Rigid(color=[0.4, 0.4, 0.4, 1.0])
    for pos in [[-5.8, -1.0, 0], [3.0, 7.0, 0]]:
        shelf = gs.morphs.Box(size=[0.5, 1.5, 2.0], pos=pos)
        world.add_entity(morph=shelf, material=tall_shelf_mat)

    # Medium shelves
    med_shelf_mat = gs.materials.Rigid(color=[0.45, 0.45, 0.45, 1.0])
    for pos in [[4.7, 0.6, 0], [4.7, -4.8, 0], [4.7, -8.7, 0], 
                [4.7, -1.2, 0], [4.7, -3.0, 0], [4.7, -6.8, 0]]:
        shelf = gs.morphs.Box(size=[0.4, 1.2, 1.5], pos=pos)
        world.add_entity(morph=shelf, material=med_shelf_mat)

    # Obstacles
    obstacle_mat = gs.materials.Rigid(color=[0.7, 0.5, 0.3, 1.0])
    for pos in [[5.7, 8.6, 0.1], [3.4, 8.6, 0.1], [-1.5, 5.2, 0.1],
                [3.3, 3.8, 0.1], [5.5, 3.8, 0.1], [5.4, 6.1, 0.1],
                [3.2, 6.1, 0.1], [-1.6, 2.3, 0.1], [-1.2, 9.4, 0.1],
                [-1.6, -7.8, 0.1], [-1.6, 7.7, 0.1]]:
        obstacle = gs.morphs.Box(size=[0.3, 0.3, 0.3], pos=pos)
        world.add_entity(morph=obstacle, material=obstacle_mat)

    # Cameras
    overhead_cam = gs.morphs.Camera(resolution=[1280, 720], pos=[0, 0, 8.5], 
                                    rot_euler=[1.5707963, 0, 0], name="overhead_cam")
    world.add_entity(morph=overhead_cam)

    aisle_cam = gs.morphs.Camera(resolution=[1280, 720], pos=[4.7, -10.5, 2.0],
                                 rot_euler=[0.2, 0, 1.5707963], name="aisle_cam")
    world.add_entity(morph=aisle_cam)

    entrance_cam = gs.morphs.Camera(resolution=[1280, 720], pos=[-7.5, 10.0, 4.0],
                                    rot_euler=[0.4, 0, -0.7854], name="entrance_cam")
    world.add_entity(morph=entrance_cam)

    return world
