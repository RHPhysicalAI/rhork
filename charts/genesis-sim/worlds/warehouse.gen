"""Procedural warehouse world for Genesis AI (v1.1.1).

Includes ground plane, walls, shelves, obstacles, and 3 cameras.
"""

import genesis as gs


def create_world():
    """Create and return the scene and camera list."""
    scene = gs.Scene()

    # Ground plane (20m x 20m x 0.1m)
    ground = gs.morphs.Box(size=[20, 20, 0.1], pos=[0, 0, -0.05])
    scene.add_entity(morph=ground)

    # Warehouse walls (4 perimeter walls, 2.5m tall)
    north_wall = gs.morphs.Box(size=[20, 0.2, 2.5], pos=[0, 10, 1.25])
    scene.add_entity(morph=north_wall)

    south_wall = gs.morphs.Box(size=[20, 0.2, 2.5], pos=[0, -10, 1.25])
    scene.add_entity(morph=south_wall)

    east_wall = gs.morphs.Box(size=[0.2, 20, 2.5], pos=[10, 0, 1.25])
    scene.add_entity(morph=east_wall)

    west_wall = gs.morphs.Box(size=[0.2, 20, 2.5], pos=[-10, 0, 1.25])
    scene.add_entity(morph=west_wall)

    # Tall shelves (F-type) - 2.0m tall
    for pos in [[-5.8, -1.0, 0], [3.0, 7.0, 0]]:
        shelf = gs.morphs.Box(size=[0.5, 1.5, 2.0], pos=pos)
        scene.add_entity(morph=shelf)

    # Medium shelves (D/E-type) - 1.5m tall, arranged in right cluster
    for pos in [[4.7, 0.6, 0], [4.7, -4.8, 0], [4.7, -8.7, 0],
                [4.7, -1.2, 0], [4.7, -3.0, 0], [4.7, -6.8, 0]]:
        shelf = gs.morphs.Box(size=[0.4, 1.2, 1.5], pos=pos)
        scene.add_entity(morph=shelf)

    # Small obstacles scattered
    for pos in [[5.7, 8.6, 0.1], [3.4, 8.6, 0.1], [-1.5, 5.2, 0.1],
                [3.3, 3.8, 0.1], [5.5, 3.8, 0.1], [5.4, 6.1, 0.1],
                [3.2, 6.1, 0.1], [-1.6, 2.3, 0.1], [-1.2, 9.4, 0.1],
                [-1.6, -7.8, 0.1], [-1.6, 7.7, 0.1]]:
        obstacle = gs.morphs.Box(size=[0.3, 0.3, 0.3], pos=pos)
        scene.add_entity(morph=obstacle)

    cameras = [
        scene.add_camera(res=(1280, 720), pos=(0, 0, 8.5), lookat=(0, 0, 0)),
        scene.add_camera(res=(1280, 720), pos=(4.7, -10.5, 2.0), lookat=(4.7, -5.0, 1.0)),
        scene.add_camera(res=(1280, 720), pos=(-7.5, 10.0, 4.0), lookat=(0, 0, 1.0)),
    ]

    return {"scene": scene, "cameras": cameras}
